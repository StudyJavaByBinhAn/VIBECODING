# Copy thành .env và chỉnh giá trị thật khi cần. Giá trị dưới đây là default dev
# (đã đúng ngay cả khi không set — .env chỉ cần thiết khi muốn override, vd. deploy thật).
# docker-compose.yml tự đọc file .env cùng thư mục nếu có.

# --- Database ---
# Nếu app chạy trong container (./deploy.sh run) và Postgres/Redis chạy qua docker-compose:
# đổi DB_HOST=dental-db, REDIS_HOST=dental-redis, và chạy app trên cùng network với compose
# (vd. `./deploy.sh run --network antijob_default`) — "localhost" bên trong container KHÔNG
# trỏ tới container khác được, chỉ đúng khi app chạy trực tiếp bằng ./gradlew bootRun trên host.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Email ---
# Mặc định trỏ vào MailHog (docker-compose) — SMTP giả lập, không cần auth, xem mail tại
# http://localhost:8025. Đổi sang SMTP thật (Gmail, SendGrid...) khi cần: set MAIL_HOST/PORT
# thật + MAIL_USERNAME/MAIL_PASSWORD + MAIL_SMTP_AUTH=true + MAIL_SMTP_STARTTLS=true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@vibecode-dental.local

# --- JWT ---
# BẮT BUỘC đổi khi deploy thật — giá trị mặc định trong application.yaml chỉ dùng cho dev.
# Tạo secret mới: openssl rand -base64 32
# Khi chạy với SPRING_PROFILES_ACTIVE=prod, app FAIL TO START nếu JWT_SECRET vẫn là giá trị
# default dưới đây (StartupSecurityValidator) — bắt buộc phải đổi, không thể quên.
JWT_SECRET=dGhpcy1pcy1hLWRldi1vbmx5LXNlY3JldC1rZXktY2hhbmdlLWluLXByb2Q=
JWT_EXPIRATION_MS=86400000

# --- Admin bootstrap (Phase 9) ---
# Dev (không set SPRING_PROFILES_ACTIVE=prod): ADMIN_PASSWORD rỗng -> tự seed admin@vibecode.local/admin123 như cũ.
# Prod (SPRING_PROFILES_ACTIVE=prod): BẮT BUỘC set ADMIN_PASSWORD để tạo tài khoản ADMIN đầu tiên,
# nếu để rỗng thì app vẫn start nhưng KHÔNG tạo admin nào (tự log warning, không có backdoor mặc định).
ADMIN_EMAIL=admin@vibecode.local
ADMIN_PASSWORD=

# --- CORS ---
# Danh sách origin được phép gọi API từ trình duyệt (cách nhau bằng dấu phẩy), vd. https://app.example.com.
# Để rỗng = không origin nào được phép (an toàn mặc định, chỉ chặn browser — curl/Postman/mobile không bị ảnh hưởng).
CORS_ALLOWED_ORIGINS=

# --- Spring profile ---
# Để trống khi dev (mặc định). Set "prod" khi deploy thật — kích hoạt application-prod.yaml
# (tắt show-sql) + fail-fast JWT_SECRET + gate ADMIN seed như mô tả ở trên.
SPRING_PROFILES_ACTIVE=
