# Copy thành .env và chỉnh giá trị thật khi cần. Giá trị dưới đây là default dev
# (đã đúng ngay cả khi không set — .env chỉ cần thiết khi muốn override, vd. deploy thật).
# docker-compose.yml tự đọc file .env cùng thư mục nếu có.

# --- Database ---
# Nếu app chạy trong container (./deploy.sh run) và Postgres/Redis chạy qua docker-compose:
# đổi DB_HOST=dental-db, REDIS_HOST=dental-redis, và chạy app trên cùng network với compose
# (vd. `./deploy.sh run --network antijob_default`) — "localhost" bên trong container KHÔNG
# trỏ tới container khác được, chỉ đúng khi app chạy trực tiếp bằng ./gradlew bootRun trên host.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dental_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# BẮT BUỘC đổi khi deploy thật — giá trị mặc định trong application.yaml chỉ dùng cho dev.
# Tạo secret mới: openssl rand -base64 32
JWT_SECRET=dGhpcy1pcy1hLWRldi1vbmx5LXNlY3JldC1rZXktY2hhbmdlLWluLXByb2Q=
JWT_EXPIRATION_MS=86400000
