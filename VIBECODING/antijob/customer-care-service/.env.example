# Copy thành .env và chỉnh giá trị thật khi cần. Giá trị dưới đây là default dev.

# --- MongoDB (Conversation/Message) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=care_mongo

# --- Redis (chỉ đọc, check thu hồi JWT — cùng instance với booking-service) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

